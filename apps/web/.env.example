# Copy to `.env.local` for explicit local settings. Loopback OAuth activates
# automatically on localhost/127.0.0.1, including with next start.

# =============================================================================
# NEXT_PUBLIC_APP_ENV
# =============================================================================
# Drives UX that must differ between localhost and the public site:
# apps/web/src/components/shared/EnvironmentBanner.tsx (ribbon),
# SaveUrlBar verbose / [DEBUG] success copy, library “External / AT record” dev chips
# (apps/web/src/lib/environmentBanner.ts + SavedRows).
#
# IMPORTANT — default when unset (see getAppEnv() in environmentBanner.ts):
#   `next dev` → **local** (yellow LOCAL banner)
#   Vercel Production → prod; Preview → dev (next.config.ts)
#   Other hosts → set explicitly (`dev` or `prod`)
#   Explicit NEXT_PUBLIC_APP_ENV or APP_ENV always wins.
#
# Supported values:
#   prod — Public product behavior: no ribbon, generic save messages, no storage
#           dev badges on library rows (see `NEXT_PUBLIC_APP_ENV === "prod"` checks).
#   local — Explicit local workflow: yellow LOCAL banner, verbose/debug save copy,
#           dev badges on rows (same as omitting the variable locally).
#   dev — Red DEV banner plus the same verbose/dev affordances as `local`.
#   test — Red TESTING banner (e.g. testing.latr.link); same dev affordances as `dev`.
#
# Any other explicit string has no entry in ENVIRONMENT_BANNER_CONFIG — the ribbon
# stays hidden (`EnvironmentBanner.tsx`). SaveUrlBar verbose/debug hints still use
# `showSaveOutcomeDebugLabels()` (`prod` off; `local`/`dev`/loopback on).
#
# Preview deployments: omit both vars for DEV banner, or set prod to mimic production UX.
# APP_ENV=dev
NEXT_PUBLIC_APP_ENV=local

# Same as NEXT_PUBLIC_APP_ENV=local if you prefer:
# NEXT_PUBLIC_ATPROTO_LOCAL=true

# Optional: local-only UI demo mode. When set to 1 with NEXT_PUBLIC_APP_ENV=local,
# the web app bypasses OAuth/gateway calls and shows deterministic local dummy data
# for the library UI. This is forced off for prod/dev/test app environments.
# NEXT_PUBLIC_LATR_DEMO_DATA=1

# Optional: full redirect URI registered in the loopback client_id (default = this origin + /callback, localhost→127.0.0.1)
# NEXT_PUBLIC_LOCAL_REDIRECT_URI=http://127.0.0.1:3000/callback

# Optional: ms — cap BrowserOAuthClient.load (metadata fetch / init) default 10000
# NEXT_PUBLIC_OAUTH_CLIENT_LOAD_TIMEOUT_MS=10000

# Optional: ms — cap OAuth session restore (default 8000).
# NEXT_PUBLIC_AUTH_RESTORE_TIMEOUT_MS=8000

# Optional: ms — per-request fetch deadline for OAuth HTTP (default 90000). Native fetch has no timeout.
# NEXT_PUBLIC_OAUTH_FETCH_DEADLINE_MS=90000

# Optional: ms — full initCallback budget (default 60000)
# NEXT_PUBLIC_OAUTH_CALLBACK_TIMEOUT_MS=60000

# Optional: use response_mode=query (?code&state on /callback) instead of URL fragment — try if callback never completes.
# NEXT_PUBLIC_OAUTH_RESPONSE_MODE=query

# L@tr gateway: browsers call their own origin's /api/latr-gateway proxy.
# The proxy selects the Go backend; public bootstrap contains no credentials.
# Vercel Services supplies these server-only bindings. For local development,
# export or configure the addresses of your running Go services:
# LATR_GATEWAY_INTERNAL_URL=http://127.0.0.1:8080
# LATR_METADATA_INTERNAL_URL=http://127.0.0.1:8081
#
# Optional backend fallback outside Vercel. Hosted Vercel requires its service
# binding and will not fall back to another deployment. Keep environment URLs
# paired; the browser still uses its same-origin proxy.
# NEXT_PUBLIC_LATR_GATEWAY_URL=https://api.testing.latr.link
#
# Internal server-only credentials. Match the gateway environment's
# LATR_GATEWAY_OFFICIAL_CLIENT_CREDENTIALS; no key issuance/database is involved.
# Use either the single official credential or the paired ID/secret headers.
# LATR_GATEWAY_CLIENT_CREDENTIAL=replace-me
# LATR_GATEWAY_CLIENT_ID=latr-link-web
# LATR_GATEWAY_API_KEY=replace-me
#
# Shared server-only HMAC secret on the web proxy and Go services. Required on
# Vercel to preserve the public method/URL for DPoP across service hops.
# LATR_GATEWAY_PROXY_SECRET=replace-me

# --- Production / hosted metadata (NEXT_PUBLIC_APP_ENV=prod recommended) ---
# Optional override for hosted OAuth (preview/prod). Default: same-origin /client-metadata.json
# NEXT_PUBLIC_ATPROTO_CLIENT_ID=https://latr.link/client-metadata.json
