# Extension runtime environment (Vite / WXT)
# Copy to .env.local for development builds. Store packaging ignores this file.

# Testing aliases point to a Vercel branch preview. The web proxy injects the
# internal first-party credential server-side; no extension API key is required.
VITE_LATR_GATEWAY_URL=https://testing.latr.link/api/latr-gateway
VITE_LATR_APP_ENV=test
VITE_LATR_GATEWAY_CLIENT_ID=
VITE_LATR_GATEWAY_API_KEY=

# Public OAuth metadata and its matching hosted callback must be reachable.
VITE_ATPROTO_CLIENT_ID=https://api.testing.latr.link/oauth/extension-client-metadata.json
VITE_ATPROTO_REDIRECT_URI=https://testing.latr.link/extension/callback

# Web app for "Open library".
VITE_LATR_WEB_URL=https://testing.latr.link
