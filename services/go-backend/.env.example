# Server-side secrets only. Separate preview and production values in Vercel.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
# Internal official clients only; no public registration or issued developer keys.
# client-id=credential pairs separated by comma/semicolon; base64 padding is preserved.
# Generate independent random secrets for each internal client and environment.
# Use client-id=old-secret|new-secret for overlapping rotation. Existing internal
# keys may use client-id=sha256:hex|sha256:hex without a database lookup.
# When sourcing this file in a shell, quote values containing ; or |.
# Startup rejects empty/malformed entries, duplicate client IDs and invalid hashes.
LATR_GATEWAY_OFFICIAL_CLIENT_CREDENTIALS=
LATR_GATEWAY_PROXY_SECRET=
CRON_SECRET=
# Optional compatibility origin for extension OAuth callbacks on api.latr.link.
# Leave unset on previews so metadata stays deployment-relative.
LATR_GATEWAY_OAUTH_PUBLIC_ORIGIN=
PLC_URL=https://plc.directory
PORT=8080
